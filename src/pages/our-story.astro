---
import Base from '../layouts/Base.astro';
---
<Base
  title="Our Story — KALA Greek and More"
  description="The story of KALA — a family-run Greek restaurant rooted in Mediterranean tradition and the coastal kitchen."
  current="/our-story"
>

  <!-- Page header -->
  <section class="page-header has-bg is-story">
    <div class="container">
      <h1>OUR STORY</h1>
      <span class="page-sub">rooted in tradition</span>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus quis
        pellentesque magna. Praesent ut sollicitudin ligula, vitae laoreet justo.
      </p>
    </div>
  </section>

  <!-- Greek Key Divider -->
  <div class="meander-divider" aria-hidden="true"></div>

  <div class="story-page">

    <!-- Block 1 — family (emotional anchor) -->
    <section class="story-section">
      <div class="container">
        <div class="story-block">
          <div class="story-block-text">
            <span class="eyebrow">Our Family</span>
            <h2>From our family's table to <em>yours</em></h2>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus quis
              pellentesque magna. Praesent ut sollicitudin ligula, vitae laoreet justo.
            </p>
            <p>
              Curabitur dapibus laoreet eros, vitae faucibus ipsum tincidunt vitae. Nam
              ultrices, magna a porttitor laoreet, sapien lorem feugiat lectus.
            </p>
          </div>
          <figure class="story-block-image">
            <div class="story-figure-mat">
              <img
                src="/images/kala/story/family-table-greek-restaurant.webp"
                alt="Two generations of hands breaking a rustic loaf of bread over a blue-striped linen, beside a blue-and-white ceramic bowl of Kalamata olives, olive branches, and fresh herbs in soft coastal light."
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="1100" height="1473" />
            </div>
            <figcaption class="caption">Family</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Pull quote — a visual pause -->
    <section class="pull-quote-wrap">
      <div class="pull-quote">
        <span class="quote-rule" aria-hidden="true"></span>
        <span class="open-q" aria-hidden="true">&ldquo;</span>
        <blockquote>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit &mdash;
          phasellus quis pellentesque magna.
        </blockquote>
        <cite>The KALA family</cite>
        <span class="quote-rule" aria-hidden="true"></span>
      </div>
    </section>

    <!-- Block 2 — coast (reversed) -->
    <section class="story-section">
      <div class="container">
        <div class="story-block reverse">
          <div class="story-block-text">
            <span class="eyebrow">The Coast</span>
            <h2>Mediterranean, <em>by way of the coast</em></h2>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec euismod
              tempor lectus, sed pretium nisi tincidunt eu. Vivamus sit amet libero in
              lacus efficitur tincidunt.
            </p>
            <p>
              Nam ultrices, magna a porttitor laoreet, sapien lorem feugiat lectus, eget
              tincidunt lacus eros vitae nibh.
            </p>
            <a href="/menu" class="link-arrow">Browse the menu <span>→</span></a>
          </div>
          <figure class="story-block-image">
            <div class="story-figure-mat">
              <img
                src="/images/kala/story/coastal-village-greek.webp"
                alt="A whitewashed Greek fishing village with cobalt-blue domes above a small harbor, a weathered blue fishing boat moored below, pink bougainvillea over a sun-warmed wall, and a blue-and-white ceramic bowl of Kalamata olives in the foreground."
                loading="lazy"
                decoding="async"
                width="1100" height="1473" />
            </div>
            <figcaption class="caption">By the coast</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Block 3 — kitchen, with overlapping prep accent -->
    <section class="story-section is-warm">
      <div class="container">
        <div class="story-block">
          <div class="story-block-text">
            <span class="eyebrow">The Kitchen</span>
            <h2>Made by hand, <em>shared by the table</em></h2>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ut sollicitudin
              ligula, vitae laoreet justo. Curabitur dapibus laoreet eros, vitae faucibus ipsum
              tincidunt vitae.
            </p>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nam ultrices, magna a
              porttitor laoreet, sapien lorem feugiat lectus.
            </p>
          </div>
          <figure class="story-block-image has-overlap">
            <div class="story-figure-mat">
              <img
                src="/images/kala/story/hands-preparing-greek-food.webp"
                alt="Hands wearing a gold wedding band scattering fresh thyme onto a white block of Greek feta drizzled with golden olive oil, on a rustic wooden board beside a blue-and-white ceramic bowl of Kalamata olives, a lemon half, and a Greek-blue linen towel."
                loading="lazy"
                decoding="async"
                width="1100" height="1473" />
            </div>
            <div class="story-figure-overlap" aria-hidden="true">
              <img
                src="/images/kala/story/olive-oil-pita-prep.webp"
                alt=""
                loading="lazy"
                decoding="async" />
            </div>
            <figcaption class="caption">At the table</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Journey timeline -->
    <section class="story-timeline" aria-label="Our journey">
      <div class="container">
        <ol class="timeline-track">
          <li class="timeline-step">
            <span class="timeline-dot" aria-hidden="true"></span>
            <h3>Family</h3>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing.</p>
          </li>
          <li class="timeline-step">
            <span class="timeline-dot" aria-hidden="true"></span>
            <h3>Coast</h3>
            <p>Donec euismod tempor lectus, sed pretium nisi.</p>
          </li>
          <li class="timeline-step">
            <span class="timeline-dot" aria-hidden="true"></span>
            <h3>Kitchen</h3>
            <p>Phasellus quis pellentesque magna, vitae laoreet.</p>
          </li>
          <li class="timeline-step">
            <span class="timeline-dot" aria-hidden="true"></span>
            <h3>Table</h3>
            <p>Curabitur dapibus laoreet eros, vitae faucibus.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- Values / promises -->
    <section class="values">
      <div class="container">
        <header class="section-header center" style="max-width: 640px;">
          <span class="eyebrow">What we stand for</span>
          <h2 class="section-title">Three things we promise</h2>
          <p class="section-sub" style="margin: 0 auto;">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec euismod tempor
            lectus, sed pretium nisi tincidunt eu.
          </p>
        </header>

        <div class="values-grid">
          <article class="value-card">
            <div class="value-image">
              <img src="/images/kala/story/value-hospitality.webp" alt="A blue-and-white ceramic plate of warm pita and country bread with a halved fig and an olive, a small dish of herbed olive oil, and two cups of Greek coffee on blue-and-white striped linen." loading="lazy" decoding="async" width="760" height="505" />
              <span class="value-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 34h30"/><path d="M13 34a11 11 0 0 1 22 0"/><path d="M24 23v-4"/><path d="M21.5 20.5h5"/></svg>
              </span>
            </div>
            <h3>Hospitality</h3>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus quis pellentesque magna.</p>
          </article>

          <article class="value-card">
            <div class="value-image">
              <img src="/images/kala/story/value-tradition.webp" alt="Hands wearing a gold wedding band kneading dough on a flour-dusted wooden table with a rolling pin, a blue-and-white ceramic dish of olive oil with oregano, and a mortar and pestle with crushed herbs." loading="lazy" decoding="async" width="760" height="505" />
              <span class="value-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 38C20 30 28 18 36 11"/><path d="M19 25c-3-2-7-1-9 2 3 2 7 1 9-2Z"/><path d="M26 18c-2-3-1-7 2-9 2 3 1 7-2 9Z"/><path d="M28 27c1-3 5-5 8-4-1 3-5 5-8 4Z"/></svg>
              </span>
            </div>
            <h3>Tradition</h3>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ut sollicitudin ligula.</p>
          </article>

          <article class="value-card">
            <div class="value-image">
              <img src="/images/kala/story/value-sea.webp" alt="A whitewashed stone dock at golden hour with Greek-blue rope coiled around a bollard, a sprig of olive branch, and a small blue-and-white dish of sea salt, looking out over the calm turquoise Aegean to two distant sailboats." loading="lazy" decoding="async" width="760" height="505" />
              <span class="value-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21c3-4 7-4 10 0s7 4 10 0 7-4 10 0"/><path d="M8 30c3-4 7-4 10 0s7 4 10 0 7-4 10 0"/></svg>
              </span>
            </div>
            <h3>The Sea</h3>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec euismod tempor lectus.</p>
          </article>
        </div>
      </div>
    </section>

  </div>

  <!-- Invite CTA -->
  <section class="invite">
    <div class="container">
      <div class="invite-card">
        <span class="invite-meander" aria-hidden="true"></span>
        <div class="invite-inner">
          <span class="eyebrow">Come find us</span>
          <h2>Pull up <em>a chair</em></h2>
          <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus sit amet libero in
            lacus efficitur tincidunt.
          </p>
          <div class="invite-actions">
            <a href="/menu" class="btn btn-primary btn-lg">
              View the Menu
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="/reservations" class="btn btn-outline btn-lg">Make a Reservation</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
