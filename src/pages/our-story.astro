---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import osCoastal from '../assets/kala/story/os-coastal.webp';
import handsPreparing from '../assets/kala/story/hands-preparing-greek-food.webp';

// ---- Blue line-art illustrations (monochrome, inherit currentColor) ----
const oliveBranch = `<svg viewBox="0 0 90 60" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 54C26 48 52 36 84 8"/><path d="M30 40c-6-5-6-12-2-17 6 3 8 11 2 17Z"/><path d="M44 31c-7-3-11-9-10-15 6 2 11 9 10 15Z"/><path d="M40 44c2-7 8-11 14-11-1 6-7 11-14 11Z"/><path d="M55 33c-5-5-6-12-3-17 6 4 7 11 3 17Z"/><path d="M67 22c2-7 8-11 14-10-1 6-7 11-14 10Z"/><ellipse cx="24" cy="48" rx="3.4" ry="4.6" transform="rotate(-28 24 48)"/></svg>`;
const lemonIllo = `<svg viewBox="0 0 150 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M44 42C30 30 14 33 7 47c14 9 30 5 37-5Z"/><path d="M15 45c8-1 19 0 26 4" stroke-width="0.9"/><ellipse cx="58" cy="74" rx="33" ry="27"/><path d="M90 68c6-2 11 0 12 4-5 3-11 2-12-4Z"/><circle cx="112" cy="78" r="28"/><circle cx="112" cy="78" r="22"/><path d="M112 78 112 50M112 78 132 58M112 78 140 78M112 78 132 98M112 78 112 106M112 78 92 98M112 78 84 78M112 78 92 58" stroke-width="0.9"/></svg>`;
const ctaIllo = `<svg viewBox="0 0 210 130" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M52 26c0 17-8 27-15 27s-15-10-15-27Z"/><path d="M37 53v46"/><path d="M24 99h26"/><path d="M84 30h16v16l5 13v50a4 4 0 0 1-4 4H83a4 4 0 0 1-4-4V59l5-13Z"/><path d="M84 30v-9h16v9"/><path d="M120 96c0 7 10 12 22 12s22-5 22-12Z"/><ellipse cx="132" cy="92" rx="4" ry="5"/><ellipse cx="143" cy="90" rx="4" ry="5"/><ellipse cx="153" cy="93" rx="4" ry="5"/><path d="M176 36c11 11 17 28 15 54"/><path d="M178 50c8-3 15-1 19 4-6 5-15 3-19-4Z"/><path d="M183 68c8-3 15-1 19 4-6 5-15 3-19-4Z"/></svg>`;
const kalaStamp = `<svg viewBox="0 0 100 100" class="stamp-svg" aria-hidden="true"><circle cx="50" cy="50" r="48" fill="#fff" stroke="currentColor" stroke-width="1.1"/><circle cx="50" cy="50" r="41.5" fill="none" stroke="currentColor" stroke-width="0.7"/><defs><path id="kalaTop" d="M50 50 m-34 0 a34 34 0 0 1 68 0"/><path id="kalaBot" d="M50 50 m34 0 a34 34 0 0 1 -68 0"/></defs><text class="stamp-top"><textPath href="#kalaTop" startOffset="50%">KALA</textPath></text><text class="stamp-bot"><textPath href="#kalaBot" startOffset="50%">GREEK &#183; AND &#183; MORE</textPath></text><g transform="translate(50 52) scale(0.42) translate(-45 -30)" stroke-width="2.4">${oliveBranch.replace('<svg viewBox="0 0 90 60" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">','').replace('</svg>','')}</g></svg>`;
---
<Base
  title="Our Story — KALA Greek and More"
  description="The story of KALA — a family-run Greek restaurant rooted in Mediterranean tradition and the coastal kitchen."
  current="/our-story"
>

  <div class="os-page">

    <!-- Hero -->
    <section class="os-hero">
      <div class="container os-hero-grid">
        <div class="os-hero-text">
          <span class="os-eyebrow">Our Story <span class="os-eyebrow-line" aria-hidden="true"></span></span>
          <h1 class="os-hero-title">
            <span class="line-roman">Made by hand,</span>
            <span class="line-italic">shared by the table.</span>
            <span class="os-hero-olive" aria-hidden="true" set:html={oliveBranch} />
          </h1>
          <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. KALA is a celebration of
            Greek hospitality, rooted in family, tradition, and the flavors of the Mediterranean.
            From our kitchen to your table, we serve food made with heart.
          </p>
        </div>

        <div class="os-hero-media">
          <span class="os-coastal-bg" aria-hidden="true"></span>
          <figure class="os-photo-card">
            <video
              class="os-hero-video"
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              poster="/images/kala/story/olive-drop-poster.webp"
              aria-label="KALA engraving animation — a hand drops an olive onto a block of feta cheese."
            >
              <source src="/public/video/olive-drop.mp4" type="video/mp4" />
            </video>
          </figure>
          <span class="os-stamp" aria-hidden="true" set:html={kalaStamp} />
        </div>
      </div>
    </section>

    <!-- Greek key divider -->
    <div class="meander-divider os-divider" aria-hidden="true"></div>

    <!-- Quote band -->
    <section class="os-quote">
      <div class="container">
        <div class="os-quote-band">
          <span class="os-quote-key left" aria-hidden="true"></span>
          <span class="os-quote-key right" aria-hidden="true"></span>
          <span class="os-quote-mark" aria-hidden="true">&ldquo;</span>
          <blockquote>
            Food is our love language.<br/>
            The table is where our story is told.
          </blockquote>
          <span class="os-quote-olive" aria-hidden="true" set:html={oliveBranch} />
        </div>
      </div>
    </section>

    <!-- Coastal roots — image left, text right -->
    <section class="os-editorial">
      <div class="container os-ed-grid">
        <figure class="os-ed-media">
          <Image
            src={osCoastal}
            alt="A whitewashed Greek wall with bright blue shutters and a gnarled olive tree above the deep-blue Aegean, with white sailboats in the distance."
            loading="lazy" decoding="async" />
        </figure>
        <div class="os-ed-text">
          <span class="os-eyebrow">Mediterranean, by way of the coast</span>
          <h2 class="os-ed-title">
            <span class="line-roman">Coastal roots.</span>
            <span class="line-italic">Timeless flavors.</span>
          </h2>
          <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Inspired by the shores of
            Greece and the traditions of our family kitchen, our menu brings together simple,
            high-quality ingredients and time-honored recipes passed down for generations.
          </p>
          <a href="/menu" class="os-link">Our Food Philosophy <span aria-hidden="true">→</span></a>
        </div>
        <span class="os-ed-illo right" aria-hidden="true" set:html={oliveBranch} />
      </div>
    </section>

    <!-- Kitchen — text left, image right -->
    <section class="os-editorial reverse">
      <div class="container os-ed-grid">
        <div class="os-ed-text">
          <span class="os-eyebrow">Made by hand, every day</span>
          <h2 class="os-ed-title">
            <span class="line-roman">From our kitchen</span>
            <span class="line-italic">to your table.</span>
          </h2>
          <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. We make our dips, bake our
            bread, and prepare every dish with care — just as we would for our own family.
          </p>
          <span class="os-ed-illo lemon" aria-hidden="true" set:html={lemonIllo} />
        </div>
        <figure class="os-ed-media bordered">
          <Image
            src={handsPreparing}
            alt="Hands preparing Greek food on a rustic table — scattering herbs over feta drizzled with olive oil, beside blue-and-white ceramic bowls, a lemon, and a Greek-blue linen towel."
            loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <!-- Final CTA panel -->
    <section class="os-cta">
      <div class="container">
        <div class="os-cta-panel">
          <span class="cta-corner tl" aria-hidden="true"></span>
          <span class="cta-corner tr" aria-hidden="true"></span>
          <span class="cta-corner bl" aria-hidden="true"></span>
          <span class="cta-corner br" aria-hidden="true"></span>
          <div class="os-cta-body">
            <h2>We can't wait to welcome you.</h2>
            <div class="os-cta-rule" aria-hidden="true"><span class="diamond"></span></div>
            <div class="os-cta-actions">
              <a href="/menu" class="btn btn-primary btn-lg">View the Menu</a>
              <a href="/reservations" class="btn btn-outline btn-lg">Make a Reservation</a>
            </div>
          </div>
          <span class="os-cta-illo" aria-hidden="true" set:html={ctaIllo} />
        </div>
      </div>
    </section>

  </div>

</Base>
