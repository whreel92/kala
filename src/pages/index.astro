---
import Base from '../layouts/Base.astro';
import IntroDoorTransition from '../components/IntroDoorTransition.astro';
import { Image } from 'astro:assets';
import kalaEmblem from '../assets/kala/home/kala-emblem.webp';
import menuGyros from '../assets/kala/home/menu-gyros.webp';
import menuSouvlaki from '../assets/kala/home/menu-souvlaki.webp';
import menuSalad from '../assets/kala/home/menu-salad.webp';
import menuDips from '../assets/kala/home/menu-dips.webp';
import menuSeafood from '../assets/kala/home/menu-seafood.webp';
import menuWine from '../assets/kala/home/menu-wine.webp';
import menuDesserts from '../assets/kala/home/menu-desserts.webp';
import bannerMadeWithLove from '../assets/kala/home/banner-made-with-love.webp';
import sharedTable from '../assets/kala/home/shared-table.webp';
import storyTable from '../assets/kala/home/story-table.webp';
import handOlive from '../assets/kala/hand_olive.png';
---
<Base
  title="KALA — Greek and More"
  description="KALA — Greek and More. A coastal Mediterranean restaurant serving gyros, souvlaki, fresh salads, and Greek classics."
  current="/"
>

<!-- One-time cinematic "enter through the Greek doors" intro (first visit / per session) -->
<IntroDoorTransition />

<!-- Hero — looping hand-engraving animation behind the brand wordmark -->
<section class="hero is-revealed">
  <div class="hero-media">
    <video
      class="hero-bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/public/hands-composite.png"
      aria-label="KALA — engraving animation: a hand drops an olive onto feta while another pours wine into a glass"
    >
      <source src="/public/video/hands-animation.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="hero-content container">
    <div class="hero-text">
      <span class="hero-address">1500 Queen Anne Ave N</span>
      <span class="eyebrow eyebrow-light">Coastal · Mediterranean · Destination</span>
      <h1 class="hero-emblem">
        <Image
          src={kalaEmblem}
          alt="KALA — Greek and More"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </h1>
      <p class="hero-sub">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus quis pellentesque
        magna. Praesent ut sollicitudin ligula, vitae laoreet justo. Curabitur dapibus laoreet
        eros.
      </p>
      <div class="hero-buttons">
        <a href="/order" class="btn btn-primary btn-lg">
          Order Online
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/reservations" class="btn btn-ghost btn-lg">Make a Reservation</a>
      </div>
    </div>

  </div>

  <a href="#callout" class="scroll-cue" aria-label="Scroll to content">
    <span>scroll</span>
    <svg viewBox="0 0 14 24" aria-hidden="true">
      <rect x="0.5" y="0.5" width="13" height="23" rx="6.5" fill="none" stroke="currentColor"/>
      <circle cx="7" cy="7" r="2" fill="currentColor"/>
    </svg>
  </a>
</section>

<!-- A Taste of Greece — auto-scrolling dish marquee -->
<section class="dish-marquee" aria-label="A taste of Greek dishes from KALA">
  <div class="dish-marquee-eyebrow">
    <span class="eyebrow">A taste of Greece</span>
  </div>
  <div class="dish-marquee-viewport">
    <div class="dish-marquee-track">
      <a href="/menu#gyros" class="dish-tile">
        <div class="dish-tile-frame"><img src="/public/e04b7c58-8d54-487c-9f41-5f660e52bc91.png" alt="Classic pork gyro wrapped in warm pita with tzatziki, tomato, onion, and fries." loading="lazy" /></div>
        <span class="dish-tile-name">Gyros</span>
      </a>
      <a href="/menu#souvlaki" class="dish-tile">
        <div class="dish-tile-frame"><img src="/public/e35b56c1-78a3-4f00-bc59-fef11d51ab97.png" alt="Grilled chicken souvlaki skewers with lemon and oregano." loading="lazy" /></div>
        <span class="dish-tile-name">Chicken Souvlaki</span>
      </a>
      <a href="/menu#salads" class="dish-tile">
        <div class="dish-tile-frame"><img src="/public/b428f5ae-26b3-47b3-944d-cc950b096d0f.png" alt="Horiatiki — traditional Greek salad with tomato, cucumber, feta, and olives." loading="lazy" /></div>
        <span class="dish-tile-name">Horiatiki</span>
      </a>
      <a href="/menu#dips" class="dish-tile">
        <div class="dish-tile-frame"><img src="/public/c243bbfd-cba9-4c8b-b273-3abc24c8f935.png" alt="Tzatziki — creamy yogurt and cucumber dip with herbs." loading="lazy" /></div>
        <span class="dish-tile-name">Tzatziki</span>
      </a>
      <a href="/menu#seafood" class="dish-tile">
        <div class="dish-tile-frame"><img src="/public/branzino.png" alt="Whole grilled branzino with lemon and herbs." loading="lazy" /></div>
        <span class="dish-tile-name">Whole Branzino</span>
      </a>
      <a href="/menu#seafood" class="dish-tile">
        <div class="dish-tile-frame"><img src="/public/grilled-octopus.png" alt="Grilled octopus with lemon, olive oil, and fresh herbs." loading="lazy" /></div>
        <span class="dish-tile-name">Grilled Octopus</span>
      </a>
      <a href="/menu#souvlaki" class="dish-tile">
        <div class="dish-tile-frame"><img src="/public/f654d18d-85e3-4c10-ae90-00769deaa21e.png" alt="Grilled lamb skewers with rosemary and lemon." loading="lazy" /></div>
        <span class="dish-tile-name">Lamb Skewers</span>
      </a>
      <a href="/menu#salads" class="dish-tile">
        <div class="dish-tile-frame"><img src="/public/6b99cc72-6194-477d-81ca-f8102c1d044d.png" alt="Watermelon and feta salad with mint and olive oil." loading="lazy" /></div>
        <span class="dish-tile-name">Watermelon &amp; Feta</span>
      </a>
      <!-- duplicate set for seamless loop -->
      <a href="/menu#gyros" class="dish-tile" aria-hidden="true" tabindex="-1">
        <div class="dish-tile-frame"><img src="/public/e04b7c58-8d54-487c-9f41-5f660e52bc91.png" alt="" loading="lazy" /></div>
        <span class="dish-tile-name">Gyros</span>
      </a>
      <a href="/menu#souvlaki" class="dish-tile" aria-hidden="true" tabindex="-1">
        <div class="dish-tile-frame"><img src="/public/e35b56c1-78a3-4f00-bc59-fef11d51ab97.png" alt="" loading="lazy" /></div>
        <span class="dish-tile-name">Chicken Souvlaki</span>
      </a>
      <a href="/menu#salads" class="dish-tile" aria-hidden="true" tabindex="-1">
        <div class="dish-tile-frame"><img src="/public/b428f5ae-26b3-47b3-944d-cc950b096d0f.png" alt="" loading="lazy" /></div>
        <span class="dish-tile-name">Horiatiki</span>
      </a>
      <a href="/menu#dips" class="dish-tile" aria-hidden="true" tabindex="-1">
        <div class="dish-tile-frame"><img src="/public/c243bbfd-cba9-4c8b-b273-3abc24c8f935.png" alt="" loading="lazy" /></div>
        <span class="dish-tile-name">Tzatziki</span>
      </a>
      <a href="/menu#seafood" class="dish-tile" aria-hidden="true" tabindex="-1">
        <div class="dish-tile-frame"><img src="/public/branzino.png" alt="" loading="lazy" /></div>
        <span class="dish-tile-name">Whole Branzino</span>
      </a>
      <a href="/menu#seafood" class="dish-tile" aria-hidden="true" tabindex="-1">
        <div class="dish-tile-frame"><img src="/public/grilled-octopus.png" alt="" loading="lazy" /></div>
        <span class="dish-tile-name">Grilled Octopus</span>
      </a>
      <a href="/menu#souvlaki" class="dish-tile" aria-hidden="true" tabindex="-1">
        <div class="dish-tile-frame"><img src="/public/f654d18d-85e3-4c10-ae90-00769deaa21e.png" alt="" loading="lazy" /></div>
        <span class="dish-tile-name">Lamb Skewers</span>
      </a>
      <a href="/menu#salads" class="dish-tile" aria-hidden="true" tabindex="-1">
        <div class="dish-tile-frame"><img src="/public/6b99cc72-6194-477d-81ca-f8102c1d044d.png" alt="" loading="lazy" /></div>
        <span class="dish-tile-name">Watermelon &amp; Feta</span>
      </a>
    </div>
  </div>
</section>

<!-- Greek Key Divider -->
<div class="meander-divider" aria-hidden="true"></div>

<!-- Order Callout -->
<section class="callout" id="callout">
  <div class="container">
    <div class="callout-frame">
      <span class="callout-eyebrow">Lunch Service</span>
      <h2 class="callout-title">
        Available for Lunch <em>Tuesday – Saturday</em>
      </h2>
      <p class="callout-sub">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus sit amet
        libero in lacus efficitur tincidunt.
      </p>
      <a href="/order" class="btn btn-primary btn-lg">
        Order for Pickup or Delivery
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <div class="callout-corner top-left" aria-hidden="true"></div>
      <div class="callout-corner top-right" aria-hidden="true"></div>
      <div class="callout-corner bottom-left" aria-hidden="true"></div>
      <div class="callout-corner bottom-right" aria-hidden="true"></div>
    </div>
  </div>
</section>

<!-- Menu Preview -->
<section class="menu-section" id="menu">
  <div class="container">
    <header class="section-header">
      <span class="eyebrow">From the kitchen</span>
      <h2 class="section-title">
        A taste of <em>Greece</em>
        <br/>and beyond
      </h2>
      <p class="section-sub">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam erat volutpat.
        Nullam vehicula, urna at imperdiet placerat.
      </p>
    </header>

    <div class="menu-grid">
      <a href="/menu#gyros" class="menu-card menu-card--feature">
        <div class="card-image"><Image src={menuGyros} alt="Greek gyro with seasoned meat, tzatziki, tomato and red onion in warm pita on a blue-and-white plate." loading="lazy" decoding="async" /></div>
        <div class="card-body">
          <h3>Gyros</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ut.</p>
          <span class="card-arrow" aria-hidden="true">→</span>
        </div>
      </a>

      <a href="/menu#souvlaki" class="menu-card menu-card--feature">
        <div class="card-image"><Image src={menuSouvlaki} alt="Grilled chicken souvlaki skewers with lemon and oregano on a blue-and-white plate." loading="lazy" decoding="async" /></div>
        <div class="card-body">
          <h3>Souvlaki</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ut.</p>
          <span class="card-arrow" aria-hidden="true">→</span>
        </div>
      </a>

      <a href="/menu#salads" class="menu-card">
        <div class="card-image"><Image src={menuSalad} alt="Horiatiki Greek salad with tomato, cucumber, feta and olives in a blue-and-white bowl." loading="lazy" decoding="async" /></div>
        <div class="card-body">
          <h3>Greek Salads</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ut.</p>
          <span class="card-arrow" aria-hidden="true">→</span>
        </div>
      </a>

      <a href="/menu#dips" class="menu-card">
        <div class="card-image"><Image src={menuDips} alt="Trio of Greek dips — tzatziki, hummus and fava — with warm pita." loading="lazy" decoding="async" /></div>
        <div class="card-body">
          <h3>Dips &amp; Spreads</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ut.</p>
          <span class="card-arrow" aria-hidden="true">→</span>
        </div>
      </a>

      <a href="/menu#seafood" class="menu-card">
        <div class="card-image"><Image src={menuSeafood} alt="Whole grilled branzino with lemon, olive oil and herbs on a blue-and-white platter." loading="lazy" decoding="async" /></div>
        <div class="card-body">
          <h3>Seafood</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ut.</p>
          <span class="card-arrow" aria-hidden="true">→</span>
        </div>
      </a>

      <a href="/menu#wine" class="menu-card">
        <div class="card-image"><Image src={menuWine} alt="Two glasses of crisp white wine with a bottle on a white linen table." loading="lazy" decoding="async" /></div>
        <div class="card-body">
          <h3>Wine</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ut.</p>
          <span class="card-arrow" aria-hidden="true">→</span>
        </div>
      </a>

      <a href="/menu#desserts" class="menu-card">
        <div class="card-image"><Image src={menuDesserts} alt="Greek baklava and galaktoboureko with honey and pistachio on a blue-and-white plate." loading="lazy" decoding="async" /></div>
        <div class="card-body">
          <h3>Desserts</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ut.</p>
          <span class="card-arrow" aria-hidden="true">→</span>
        </div>
      </a>

      <a href="/menu" class="menu-card menu-card-cta">
        <div>
          <span class="eyebrow">Hungry?</span>
          <h3>View the Full Menu</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed pulvinar.</p>
        </div>
        <span class="card-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<!-- Tagline ribbon — heartfelt punctuation between the menu and the table -->
<section class="banner-ribbon" aria-label="Greek food made with love">
  <div class="container">
    <Image
      src={bannerMadeWithLove}
      alt="Ribbon banner reading &ldquo;Greek food made with love.&rdquo;"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<!-- Shared by the table — editorial image + copy -->
<section class="sharedtable" id="table">
  <div class="container sharedtable-grid">
    <figure class="sharedtable-media">
      <Image
        src={sharedTable}
        alt="A Greek mezze spread on blue-and-white ceramics — souvlaki, tzatziki, hummus, horiatiki salad, lemon potatoes, pita, olives, and white wine on a white linen table."
        loading="lazy"
        decoding="async"
      />
      <span class="sharedtable-frame" aria-hidden="true"></span>
    </figure>

    <div class="sharedtable-text">
      <span class="eyebrow">Around the table</span>
      <h2 class="section-title">
        Shared by
        <em>the table</em>
      </h2>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus quis
        pellentesque magna. Praesent ut sollicitudin ligula, vitae laoreet justo.
      </p>
      <p>
        Curabitur dapibus laoreet eros, vitae faucibus ipsum tincidunt vitae. Nam
        ultrices, magna a porttitor laoreet.
      </p>
      <div class="sharedtable-actions">
        <a href="/reservations" class="btn btn-primary btn-lg">
          Make a Reservation
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/menu" class="link-arrow">View the menu <span>→</span></a>
      </div>
    </div>
  </div>
</section>

<!-- Story / Animation Section -->
<section class="story" id="story">
  <div class="container story-grid">
    <div class="story-text">
      <span class="eyebrow">Our Story</span>
      <h2 class="section-title">
        Made by hand,
        <em>shared by the table</em>
      </h2>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus quis
        pellentesque magna. Praesent ut sollicitudin ligula, vitae laoreet justo.
      </p>
      <p>
        Curabitur dapibus laoreet eros, vitae faucibus ipsum tincidunt vitae. Nam
        ultrices, magna a porttitor laoreet, sapien lorem feugiat lectus, eget
        tincidunt lacus eros vitae nibh.
      </p>
      <a href="/our-story" class="link-arrow">Read our story <span>→</span></a>
    </div>

    <div class="story-visual">
      <div class="vis-glow" aria-hidden="true"></div>

      <figure class="story-photo">
        <Image
          src={storyTable}
          alt="Hands sharing Greek mezze across a white linen table set with blue-and-white ceramics."
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="story-accent" aria-hidden="true">
        <Image src={handOlive} alt="" loading="lazy" />
      </figure>

      <svg class="key-ribbon" aria-hidden="true" viewBox="0 0 600 40" preserveAspectRatio="none">
        <pattern id="meander" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M0 30 H 24 V 10 H 16 V 22 H 8 V 4 H 32 V 22 H 40" fill="none" stroke="#194B9E" stroke-width="2"/>
        </pattern>
        <rect width="600" height="40" fill="url(#meander)"/>
      </svg>
    </div>
  </div>
</section>

</Base>
