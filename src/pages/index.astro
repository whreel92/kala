---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import kalaEmblem from '../assets/kala/home/kala-emblem.webp';
import sharedTable from '../assets/kala/home/shared-table.webp';
import storyTable from '../assets/kala/home/story-table.webp';
---
<Base
  title="KALA — Greek and More"
  description="KALA — Greek and More. A Mediterranean restaurant serving gyros, souvlaki, fresh salads, and Greek classics."
  current="/"
>

<!-- Hero — calm static emblem over a single still image -->
<section class="hero is-revealed">
  <div class="hero-media">
    <img src="/public/hands-composite.webp" alt="" decoding="async" fetchpriority="high" />
  </div>

  <div class="hero-content container">
    <div class="hero-text">
      <span class="eyebrow eyebrow-light">Greek and More</span>
      <h1 class="hero-emblem">
        <Image
          src={kalaEmblem}
          alt="KALA — Greek and More"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </h1>
      <span class="hero-address">1500 Queen Anne Ave N</span>
      <div class="hero-buttons">
        <a href="/order" class="btn btn-primary btn-lg">
          Order Online
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/reservations" class="btn btn-ghost btn-lg">Make a Reservation</a>
      </div>
    </div>
  </div>
</section>

<!-- Lunch Service callout -->
<section class="callout" id="callout">
  <div class="container">
    <div class="callout-frame">
      <span class="callout-eyebrow">Lunch Service</span>
      <h2 class="callout-title">
        Available for Lunch <br /><em>Tuesday – Saturday</em>
      </h2>
      <p class="callout-sub">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus sit amet
        libero in lacus efficitur tincidunt.
      </p>
      <a href="/order" class="btn btn-primary btn-lg">
        Order for Pickup or Delivery
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Menu — text-forward, links to the full menu -->
<section class="menu-section menu-section--simple" id="menu">
  <div class="container">
    <header class="section-header">
      <span class="eyebrow">From the kitchen</span>
      <h2 class="section-title">
        A taste of <em>Greece</em>
        <br/>and beyond
      </h2>
      <p class="section-sub">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam erat volutpat.
        Nullam vehicula, urna at imperdiet placerat.
      </p>
      <a href="/menu" class="btn btn-primary btn-lg">
        View the Menu
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </header>
  </div>
</section>

<!-- Shared by the table — one editorial photo + copy -->
<section class="sharedtable" id="table">
  <div class="container sharedtable-grid">
    <figure class="sharedtable-media">
      <Image
        src={sharedTable}
        alt="KALA's airy dining room — white banquettes with blue cushions, blue velvet chairs and gold-base marble tables along a sunlit wall of windows, beneath a warm timber ceiling and woven pendant lights."
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="sharedtable-text">
      <span class="eyebrow">Around the table</span>
      <h2 class="section-title">
        Shared by
        <em>the table</em>
      </h2>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus quis
        pellentesque magna. Praesent ut sollicitudin ligula, vitae laoreet justo.
      </p>
      <div class="sharedtable-actions">
        <a href="/reservations" class="btn btn-primary btn-lg">
          Make a Reservation
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/menu" class="link-arrow">View the menu <span>→</span></a>
      </div>
    </div>
  </div>
</section>

<!-- Story teaser -->
<section class="story" id="story">
  <div class="container story-grid">
    <div class="story-text">
      <span class="eyebrow">Our Story</span>
      <h2 class="section-title">
        Made by hand,
        <em>shared by the table</em>
      </h2>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus quis
        pellentesque magna. Praesent ut sollicitudin ligula, vitae laoreet justo.
      </p>
      <a href="/our-story" class="link-arrow">Read our story <span>→</span></a>
    </div>

    <div class="story-visual">
      <figure class="story-photo">
        <Image
          src={storyTable}
          alt="Friends laughing over a shared Greek feast — souvlaki, spanakopita, salad and white wine on marble tables in KALA's sunlit, window-lined dining room."
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

</Base>
