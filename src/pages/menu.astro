---
import Base from '../layouts/Base.astro';

// Reusable blue line-art illustrations (monochrome, inherit currentColor)
const oliveSprig = `<svg class="illo illo-olive" viewBox="0 0 64 134" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M42 6c-7 10-11 23-13 38-3 22-2 50 1 84"/><path d="M28 36c-7-5-16-5-22-1 5 7 14 9 22 1Z"/><path d="M31 55c8-6 16-7 23-3-5 7-15 9-23 3Z"/><path d="M27 74c-7-5-16-5-22-1 5 7 14 9 22 1Z"/><path d="M30 93c8-6 16-7 23-3-5 7-15 9-23 3Z"/><ellipse cx="20" cy="46" rx="4.6" ry="6.4" transform="rotate(-24 20 46)"/><ellipse cx="42" cy="65" rx="4.6" ry="6.4" transform="rotate(22 42 65)"/></svg>`;
