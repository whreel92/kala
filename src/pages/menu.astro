---
import Base from '../layouts/Base.astro';

// Blue line-art illustrations (monochrome, inherit currentColor).
const oliveSprig = `<svg viewBox="0 0 64 134" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M42 6c-7 10-11 23-13 38-3 22-2 50 1 84"/><path d="M28 36c-7-5-16-5-22-1 5 7 14 9 22 1Z"/><path d="M31 55c8-6 16-7 23-3-5 7-15 9-23 3Z"/><path d="M27 74c-7-5-16-5-22-1 5 7 14 9 22 1Z"/><path d="M30 93c8-6 16-7 23-3-5 7-15 9-23 3Z"/><ellipse cx="20" cy="46" rx="4.6" ry="6.4" transform="rotate(-24 20 46)"/><ellipse cx="42" cy="65" rx="4.6" ry="6.4" transform="rotate(22 42 65)"/></svg>`;


// Prices mirror public/menu-data.js (the online-ordering cart) so the menu
// and checkout always agree. `d` = dietary marks.
const menu = [
  {
    title: 'Dips & Spreads',
    items: [
      { n: 'Tzatziki', p: '7', d: ['gf'] },
      { n: 'Hummus', p: '7', d: ['v', 'gf'] },
      { n: 'Melitzanosalata', p: '7', d: ['v'] },
      { n: 'Taramasalata', p: '8' },
      { n: 'Tirokafteri', p: '8', d: ['spicy'] },
      { n: 'Skordalia', p: '7', d: ['v', 'gf'] },
      { n: 'Fava', p: '7', d: ['v', 'gf'] },
      { n: 'Trio Sampler', p: '15' },
    ],
  },
  {
    title: 'Salads',
    items: [
      { n: 'Horiatiki', p: '14', d: ['gf'] },
      { n: 'Mixed Greens', p: '11', d: ['v'] },
      { n: 'Beet & Walnut', p: '13', d: ['gf'] },
      { n: 'Watermelon & Feta', p: '14', d: ['gf'] },
    ],
  },
  {
    title: 'Gyros',
    items: [
      { n: 'The Classic Pork', p: '13' },
      { n: 'Chicken Gyro', p: '13' },
      { n: 'Lamb Gyro', p: '15' },
      { n: 'Garden Gyro', p: '14', d: ['v'] },
    ],
  },
  {
    title: 'Souvlaki',
    items: [
      { n: 'Chicken Souvlaki', p: '16', d: ['gf'] },
      { n: 'Pork Souvlaki', p: '16', d: ['gf'] },
      { n: 'Lamb Souvlaki', p: '19', d: ['gf'] },
      { n: 'Shrimp Souvlaki', p: '20', d: ['gf'] },
    ],
  },
  {
    title: 'From the Sea',
    items: [
      { n: 'Whole Branzino', p: '32', d: ['gf'] },
      { n: 'Grilled Octopus', p: '24', d: ['gf'] },
      { n: 'Saganaki Shrimp', p: '18', d: ['spicy'] },
      { n: 'Calamari', p: '16' },
    ],
  },
  {
    title: 'House Plates',
    items: [
      { n: 'Moussaka', p: '19' },
      { n: 'Pastitsio', p: '18' },
      { n: 'Lamb Kleftiko', p: '26', d: ['gf'] },
      { n: 'Roast Chicken', p: '20', d: ['gf'] },
    ],
  },
  {
    title: 'Sides',
    items: [
      { n: 'Lemon Potatoes', p: '6', d: ['v', 'gf'] },
      { n: 'Greek Rice', p: '5', d: ['v'] },
      { n: 'Spanakopita', p: '8' },
      { n: 'Dolmades', p: '9', d: ['v'] },
    ],
  },
  {
    title: 'Desserts',
    items: [
      { n: 'Baklava', p: '8' },
      { n: 'Galaktoboureko', p: '8' },
      { n: 'Loukoumades', p: '7' },
      { n: 'Yogurt & Honey', p: '7', d: ['gf'] },
    ],
  },
  {
    title: 'Wine & Drinks',
    items: [
      { n: 'House Red', p: '9 / 36' },
      { n: 'House White', p: '9 / 36' },
      { n: 'Assyrtiko', p: '14 / 54' },
      { n: 'Agiorgitiko', p: '14 / 54' },
      { n: 'Ouzo', p: '8' },
      { n: 'Greek Coffee', p: '4' },
      { n: 'Frappé', p: '5' },
      { n: 'Sparkling Water', p: '4' },
    ],
  },
];

const dietLabel = { v: 'V', gf: 'GF', spicy: '✦' };

// Hand-drawn illustration per category (shared with /order-pickup).
const catIllo = {
  'Dips & Spreads': 'olive',
  'Salads': 'tomato',
  'Gyros': 'gyro',
  'Souvlaki': 'souvlaki',
  'From the Sea': 'fish',
  'House Plates': 'plate',
  'Sides': 'bowl',
  'Desserts': 'dessert',
  'Wine & Drinks': 'wine',
};
const ILLO = '/images/kala/order-pickup/illustrations';

// Greek-key corner bracket (rotated per corner via CSS) — matches /order-pickup.
const cornerKey = `<svg viewBox="0 0 46 46" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 19V3h16"/><path d="M10 19v-9h9"/><path d="M16 13h-3v3"/></svg>`;
---
<Base
  title="Menu — KALA Greek and More"
  description="The full KALA menu — dips, salads, gyros, souvlaki, seafood, house plates, sides, desserts, wine and drinks."
  current="/menu"
>
  <!-- ── Printed hero — coastal sketch (left) + olive branch (right) ── -->
  <header class="pos-hero menu-hero">
    <span class="pos-hero-art pos-hero-city" aria-hidden="true">
      <img src={`${ILLO}/illo-coast-city.png`} alt="" decoding="async" />
    </span>
    <span class="pos-hero-art pos-hero-sprig" aria-hidden="true">
      <img src={`${ILLO}/illo-olive-branch.png`} alt="" decoding="async" />
    </span>
    <div class="container pos-hero-inner">
      <span class="pos-hero-eyebrow">KALA · Greek and More</span>
      <h1 class="pos-hero-title">Our Menu</h1>
      <p class="pos-hero-sub">
        Made by hand, shared by the table — from the Aegean coast to Queen Anne.
      </p>
    </div>
  </header>

  <!-- ── Greek-key divider ── -->
  <div class="pos-divider" role="presentation" aria-hidden="true">
    <span class="pos-divider-rule"></span>
    <span class="pos-divider-diamond"></span>
    <span class="pos-divider-rule"></span>
  </div>

  <!-- ── Printed-menu sheet ── -->
  <div class="menu-open">
    <div class="container pos-sheet-wrap">
      <div class="pos-sheet">
        <span class="pos-corner tl" set:html={cornerKey} aria-hidden="true" />
        <span class="pos-corner tr" set:html={cornerKey} aria-hidden="true" />
        <span class="pos-corner bl" set:html={cornerKey} aria-hidden="true" />
        <span class="pos-corner br" set:html={cornerKey} aria-hidden="true" />

        <div class="pm-columns">
          {menu.map((cat) => (
            <section class="pm-cat">
              <h2 class="pm-cat-title">{cat.title}</h2>
              <div class="pm-cat-body">
                {catIllo[cat.title] && (
                  <span class="pm-illo" aria-hidden="true">
                    <img src={`${ILLO}/illo-${catIllo[cat.title]}.png`} alt="" loading="lazy" decoding="async" />
                  </span>
                )}
                <ul class="pm-items">
                  {cat.items.map((it) => (
                    <li class="pm-item">
                      <span class="pm-name">
                        {it.n}
                        {it.d && it.d.map((mark) => (
                          <span class={`pm-diet pm-diet-${mark}`}>{dietLabel[mark]}</span>
                        ))}
                      </span>
                      <span class="pm-leader" aria-hidden="true"></span>
                      <span class="pm-price">${it.p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          ))}
        </div>

        <footer class="pm-foot">
          <div class="menu-rule menu-rule-short" role="presentation" aria-hidden="true"></div>
          <p class="pm-legend">
            <span><b>V</b> Vegetarian</span>
            <span><b>GF</b> Gluten-free</span>
            <span><b>✦</b> Spicy</span>
          </p>
          <p class="pm-tagline">
            <span class="pm-sprig" aria-hidden="true" set:html={oliveSprig} />
            Good food. Good wine. Good company.
          </p>
          <p class="pm-addr">1500 Queen Anne Ave N · Seattle · (555) 123 — 4567</p>
        </footer>
      </div>
    </div>
  </div>

  <!-- Closing order / reserve band -->
  <section class="menu-cta-band">
    <div class="container">
      <span class="eyebrow">Hungry?</span>
      <h2>Come dine with us</h2>
      <div class="pm-actions">
        <a href="/order" class="btn btn-primary btn-lg">
          Order Online
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/reservations" class="btn btn-outline btn-lg">Make a Reservation</a>
      </div>
    </div>
  </section>
</Base>
