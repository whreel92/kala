              <div class="teaser-group">
                <h3>Sweet</h3>
                <p>Baklava · Loukoumades · Greek Coffee</p>
              </div>
            </div>

            <div class="printed-rule" aria-hidden="true"><span class="diamond"></span></div>
            <p class="printed-footer">
              <span class="printed-sprig" aria-hidden="true" set:html={oliveSprig} />
              Good food. Good wine. Good company.
            </p>
          </div>

