---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import storefront from '../assets/kala/contact/kala-storefront.webp';
---
<Base
  title="Contact — KALA Greek and More"
  description="Visit, call, or write to KALA — Greek and More. Address, phone, email, hours, and directions."
  current="/contact"
>

  <!-- ── Printed hero — matches /menu (coastal sketch left, olive branch right) ── -->
  <header class="pos-hero">
    <span class="pos-hero-art pos-hero-city" aria-hidden="true">
      <img src="/images/kala/order-pickup/illustrations/illo-harbor.png" alt="" decoding="async" />
    </span>
    <span class="pos-hero-art pos-hero-sprig" aria-hidden="true">
      <img src="/images/kala/order-pickup/illustrations/illo-lemon-branch.png" alt="" decoding="async" />
    </span>
    <div class="container pos-hero-inner">
      <span class="pos-hero-eyebrow">Visit</span>
      <h1 class="pos-hero-title">Contact</h1>
      <p class="pos-hero-sub">Find us by the harbor at 1500 Queen Anne Ave N.</p>
    </div>
  </header>

  <!-- ── Greek-key divider ── -->
  <div class="pos-divider" role="presentation" aria-hidden="true">
    <span class="pos-divider-rule"></span>
    <span class="pos-divider-diamond"></span>
    <span class="pos-divider-rule"></span>
  </div>

  <!-- Contact details -->
  <section class="visit">
    <div class="container">

      <!-- Storefront atmosphere banner -->
      <figure class="contact-atmos">
        <Image
          src={storefront}
          alt="A blue-ink illustration of KALA's storefront — a white facade with an arched parapet, deep-blue Greek-key signage reading KALA Greek &amp; More, navy awnings and umbrellas over a sidewalk patio where guests dine among potted topiaries."
          widths={[640, 960, 1280]}
          sizes="(max-width: 1024px) 100vw, 1180px"
          loading="lazy"
          decoding="async" />
        <figcaption class="atmos-label">Queen Anne · Seattle</figcaption>
      </figure>

      <div class="visit-grid">
        <div class="visit-info contact-card">
          <div class="contact-card-head">
            <span class="eyebrow">The details</span>
            <span class="now-serving"><span class="dot" aria-hidden="true"></span> Now serving lunch</span>
          </div>
          <h2 class="section-title">Stop by, call, <em>or write</em></h2>
          <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec euismod
            tempor lectus, sed pretium nisi tincidunt eu.
          </p>

          <dl class="info-list">
            <div class="info-row">
              <dt>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2c-3.3 0-6 2.6-6 6 0 4.4 6 10 6 10s6-5.6 6-10c0-3.4-2.7-6-6-6Zm0 8.2A2.2 2.2 0 1 1 10 5.8a2.2 2.2 0 0 1 0 4.4Z" fill="currentColor"/></svg>
                Address
              </dt>
              <dd>
                1500 Queen Anne Ave N<br/>
                Seattle, WA 98109
              </dd>
            </div>
            <div class="info-row">
              <dt>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3h3l2 5-2 1a10 10 0 0 0 5 5l1-2 5 2v3a2 2 0 0 1-2 2A14 14 0 0 1 3 5a2 2 0 0 1 2-2Z" fill="currentColor"/></svg>
                Phone
              </dt>
              <dd><a href="tel:5551234567">(555) 123 — 4567</a></dd>
            </div>
            <div class="info-row">
              <dt>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Zm2 .5v.4l5 3.4 5-3.4v-.4H5Zm10 2.1-5 3.4-5-3.4V14.5h10V7.6Z" fill="currentColor"/></svg>
                Email
              </dt>
              <dd><a href="mailto:niko@kalaeats.com">niko@kalaeats.com</a></dd>
            </div>
            <div class="info-row">
              <dt>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm.8 4h-1.6v5l4 2.4.8-1.4-3.2-2Z" fill="currentColor"/></svg>
                Hours
              </dt>
              <dd>
                <span><b>Tue – Thu</b> · 11a – 9p</span>
                <span><b>Fri – Sat</b> · 11a – 10p</span>
                <span><b>Sun</b> · 12p – 8p</span>
                <span class="dim"><b>Mon</b> · Closed</span>
              </dd>
            </div>
          </dl>

          <div class="visit-buttons">
            <a
              href="https://www.google.com/maps/dir/?api=1&destination=1500+Queen+Anne+Ave+N+Seattle+WA+98109"
              class="btn btn-primary"
              target="_blank"
              rel="noopener noreferrer"
            >Get Directions</a>
            <a href="tel:5551234567" class="btn btn-outline">Call (555) 123-4567</a>
          </div>
        </div>

        <div class="visit-map">
          <span class="map-label">Find us in Queen Anne</span>
          <iframe
            class="map-canvas"
            title="Map of KALA at 1500 Queen Anne Ave N, Seattle"
            src="https://www.google.com/maps?q=1500+Queen+Anne+Ave+N,+Seattle,+WA+98109&z=15&output=embed"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <a
            class="map-open"
            href="https://www.google.com/maps/search/?api=1&query=1500+Queen+Anne+Ave+N+Seattle+WA+98109"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2c-3.3 0-6 2.6-6 6 0 4.4 6 10 6 10s6-5.6 6-10c0-3.4-2.7-6-6-6Zm0 8.2A2.2 2.2 0 1 1 10 5.8a2.2 2.2 0 0 1 0 4.4Z" fill="currentColor"/></svg>
            Open in Maps
          </a>
        </div>
      </div>

      <!-- Quick actions -->
      <div class="quick-actions">
        <a
          class="action-card"
          href="https://www.google.com/maps/dir/?api=1&destination=1500+Queen+Anne+Ave+N+Seattle+WA+98109"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
          </span>
          <h3>Get Directions</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing.</p>
          <span class="action-arrow" aria-hidden="true">→</span>
        </a>
        <a class="action-card" href="tel:5551234567">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h3l2 5-2.3 1.2a11 11 0 0 0 5.1 5.1L16 17l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
          </span>
          <h3>Call the Restaurant</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing.</p>
          <span class="action-arrow" aria-hidden="true">→</span>
        </a>
        <a class="action-card" href="#events">
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 9h17M8 3v4M16 3v4"/></svg>
          </span>
          <h3>Private Events</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing.</p>
          <span class="action-arrow" aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Private events & press -->
  <section class="events" id="events">
    <div class="container">
      <div class="events-card">
        <div class="events-media">
          <img
            src="/images/kala/contact/private-dining-table-greek.webp"
            alt="A Greek private-dining table set by a window — blue-and-white ceramic plates of mezze, olives, dips and pita, two glasses of white wine, an olive-branch vase, and white linen, with a coastal village view beyond."
            loading="lazy"
            decoding="async"
            width="1100" height="730" />
        </div>
        <div class="events-body">
          <span class="eyebrow">Beyond the dining room</span>
          <h2>Private events <em>&amp; press</em></h2>
          <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus sit amet
            libero in lacus efficitur tincidunt.
          </p>
          <div class="events-actions">
            <a href="mailto:niko@kalaeats.com" class="btn btn-primary btn-lg">
              Private Events
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="mailto:niko@kalaeats.com" class="btn btn-outline btn-lg">Press Inquiries</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
